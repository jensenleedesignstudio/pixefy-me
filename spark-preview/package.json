{
  "name": "pixefy-spark-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:viewer && npm run build:inline",
    "build:viewer": "esbuild src/viewer.js --bundle --minify --splitting --format=esm --outdir=../public/spark-build --entry-names=viewer --chunk-names=chunks/[name]-[hash] --legal-comments=eof",
    "build:inline": "esbuild src/inline-dust.js --bundle --minify --format=esm --legal-comments=eof --outfile=../public/inline-dust.js"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
